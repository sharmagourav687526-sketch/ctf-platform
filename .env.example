# Copy to .env and fill in. Never commit the real .env.

# ── Required in production ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000

# Public URL of the platform (used in outgoing email links). No trailing slash.
APP_URL=https://ctf.example.com

# Set to 1 when behind an HTTPS reverse proxy so client IPs and secure cookies work.
TRUST_PROXY=

# Optional overrides (defaults shown)
# DB_FILE=./data/ctf.db
# UPLOAD_DIR=./data/uploads

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email entirely (no verification, admin-only resets).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE=1    # set to 1 for port 465 (TLS), leave blank for STARTTLS
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────────
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable CAPTCHA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Discord notifications (optional) ────────────────────────────────────────
# Paste the full webhook URL from your Discord server's channel settings.
DISCORD_WEBHOOK_URL=
# Set to 1 to only post first-blood solves (suppress regular solve messages).
# DISCORD_FIRST_BLOOD_ONLY=0

# ── Login lockout (brute-force protection) ───────────────────────────────────
# After this many consecutive failures the account is locked for the lockout period.
# LOGIN_MAX_FAILS=10
# LOGIN_LOCKOUT_MINUTES=15

# ── S3-compatible file storage (optional) ────────────────────────────────────
# Leave S3_BUCKET blank to store uploads on local disk (default).
# Requires: npm install @aws-sdk/client-s3 multer-s3
#
# Works with AWS S3, Cloudflare R2, MinIO, or any S3-compatible service.
S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=https://your-minio-or-r2-endpoint   # omit for AWS S3
# S3_PUBLIC_URL=https://files.example.com          # CDN URL (no trailing slash); defaults to bucket URL
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
