<%- include('partials/header') %>
<section class="narrow">
  <h1>Two-factor authentication</h1>
  <p class="muted">Enter the 6-digit code from your authenticator app.</p>
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login/verify" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Authentication code
      <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}"
             placeholder="123 456" autofocus required maxlength="7">
    </label>
    <button type="submit" class="btn">Verify</button>
    <p class="muted small" style="margin-top:.75rem"><a href="/login">Back to login</a></p>
  </form>
</section>
<%- include('partials/footer') %>
