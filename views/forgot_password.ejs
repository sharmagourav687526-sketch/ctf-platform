<%- include('partials/header') %>
<section class="narrow">
  <h1>Forgot password</h1>
  <% if (sent) { %>
    <div class="flash flash-success" role="status">
      If that email address is registered, you'll receive a reset link shortly. Check your inbox (and spam folder).
    </div>
    <p><a href="/login">Back to login</a></p>
  <% } else { %>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <p class="muted">Enter your account email and we'll send you a link to reset your password.</p>
    <form method="post" action="/forgot-password" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email address
        <input type="email" name="email" required maxlength="254" autofocus autocomplete="email">
      </label>
      <button type="submit" class="btn">Send reset link</button>
    </form>
    <p class="muted"><a href="/login">Back to login</a></p>
  <% } %>
</section>
<%- include('partials/footer') %>
