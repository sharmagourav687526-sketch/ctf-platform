<!DOCTYPE html>
<html lang="en" data-theme="<%= settings.theme || 'default' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#05070d">
  <title><%= title ? title + ' · ' : '' %><%= settings.ctf_name %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-auth="<%= user ? '1' : '0' %>" data-mode="<%= settings.mode %>">
<canvas id="bg" class="bg-canvas" aria-hidden="true"></canvas>
<div class="bg-glow" aria-hidden="true"></div>
<div id="hck-scanlines" aria-hidden="true"></div>
<div id="hck-noise" aria-hidden="true"></div>
<div id="hck-cursor" aria-hidden="true">
  <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" width="28" height="28">
    <circle cx="14" cy="14" r="11" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 3" opacity=".5">
      <animateTransform attributeName="transform" type="rotate" from="0 14 14" to="360 14 14" dur="8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="14" cy="14" r="6" stroke="var(--accent)" stroke-width="1.5"/>
    <line x1="14" y1="1"  x2="14" y2="6"  stroke="var(--accent)" stroke-width="1.5"/>
    <line x1="14" y1="22" x2="14" y2="27" stroke="var(--accent)" stroke-width="1.5"/>
    <line x1="1"  y1="14" x2="6"  y2="14" stroke="var(--accent)" stroke-width="1.5"/>
    <line x1="22" y1="14" x2="27" y2="14" stroke="var(--accent)" stroke-width="1.5"/>
    <circle cx="14" cy="14" r="2" fill="var(--accent)"/>
  </svg>
</div>
<a href="#content" class="skip-link">Skip to content</a>
<header class="topbar">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">&gt;_</span><span class="brand-name" data-text="<%= settings.ctf_name %>"><%= settings.ctf_name %></span></a>
  <button type="button" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="main-nav">&#9776;</button>
  <nav id="main-nav" class="nav">
    <a href="/challenges" class="<%= path.startsWith('/challenges') ? 'active' : '' %>">Challenges</a>
    <a href="/scoreboard" class="<%= path.startsWith('/scoreboard') ? 'active' : '' %>">Scoreboard</a>
    <a href="/announcements" class="<%= path.startsWith('/announcements') ? 'active' : '' %>">News<span class="badge" id="news-badge" hidden></span></a>
    <% if (user && settings.mode === 'teams') { %><a href="/team" class="<%= path.startsWith('/team') ? 'active' : '' %>">My team</a><% } %>
    <% if (user && user.role === 'admin') { %><a href="/admin" class="nav-admin <%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a><% } %>
    <span class="nav-spacer"></span>
    <% if (event.start || event.end) { %>
      <span class="countdown" id="countdown" data-start="<%= event.start || '' %>" data-end="<%= event.end || '' %>" title="Event clock"></span>
    <% } %>
    <% if (user) { %>
      <a href="/users/<%= user.id %>" class="nav-user"><span class="avatar avatar-sm" data-name="<%= user.username %>"><%= user.username.charAt(0).toUpperCase() %></span><%= user.username %></a>
      <a href="/settings">Settings</a>
      <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="link-btn">Logout</button></form>
    <% } else { %>
      <a href="/login">Login</a>
      <% if (settings.registration_open === '1') { %><a href="/register" class="btn btn-small">Register</a><% } %>
    <% } %>
  </nav>
</header>
<% if (!event.started) { %>
  <div class="banner banner-info">The CTF starts <%= fmtDate(event.start) %>.</div>
<% } else if (event.ended) { %>
  <div class="banner banner-warn">The CTF has ended. Submissions are closed.</div>
<% } %>
<% if (user && !user.email_verified) { %>
  <div class="banner banner-warn">Please verify your email address.
    <form method="post" action="/resend-verification" class="inline" style="display:inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link-btn" style="text-decoration:underline">Resend verification email</button>
    </form>
  </div>
<% } %>
<main class="container" id="content">
<% if (flash) { %><div class="flash flash-<%= flash.type %>" role="status"><%= flash.text %></div><% } %>
