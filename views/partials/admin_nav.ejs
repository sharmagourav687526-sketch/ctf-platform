<nav class="subnav" aria-label="Admin">
  <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">Dashboard</a>
  <a href="/admin/challenges" class="<%= path.startsWith('/admin/challenges') ? 'active' : '' %>">Challenges</a>
  <a href="/admin/users" class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">Users</a>
  <% if (settings.mode === 'teams') { %><a href="/admin/teams" class="<%= path.startsWith('/admin/teams') ? 'active' : '' %>">Teams</a><% } %>
  <a href="/admin/submissions" class="<%= path.startsWith('/admin/submissions') ? 'active' : '' %>">Submissions</a>
  <a href="/admin/announcements" class="<%= path.startsWith('/admin/announcements') ? 'active' : '' %>">Announcements</a>
  <a href="/admin/settings" class="<%= path.startsWith('/admin/settings') ? 'active' : '' %>">Settings</a>
  <% if (user && user.role === 'admin') { %><a href="/admin/audit" class="<%= path.startsWith('/admin/audit') ? 'active' : '' %>">Audit log</a><% } %>
</nav>
<% if (user && user.role === 'monitor') { %>
  <p class="muted small" style="margin:.5rem 0 0;padding:.4rem .75rem;background:rgba(167,139,250,.12);border-left:3px solid #a78bfa;border-radius:4px">
    Monitor mode — read-only view. Contact an admin to make changes.
  </p>
<% } %>
