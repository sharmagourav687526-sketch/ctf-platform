<%- include('partials/header') %>
<h1>Scoreboard</h1>
<div id="podium" class="podium" aria-label="Top three"></div>
<div class="card chart-card">
  <canvas id="chart" width="900" height="320" role="img" aria-label="Score over time for the top 10"></canvas>
  <div id="legend" class="legend"></div>
</div>
<div class="grid-board">
  <div class="table-wrap">
    <table class="table" id="standings">
      <thead><tr><th>#</th><th><%= settings.mode === 'teams' ? 'Team' : 'Player' %></th><th class="num">Solves</th><th class="num">Score</th></tr></thead>
      <tbody><tr><td colspan="4" class="muted">Loading&hellip;</td></tr></tbody>
    </table>
  </div>
  <aside class="card">
    <div class="row-between"><h2>Live activity</h2><span class="live-dot" title="Updates automatically">live</span></div>
    <ul class="feed" id="feed"><li class="muted">Loading&hellip;</li></ul>
  </aside>
</div>
<%- include('partials/footer', { scripts: ['scoreboard'] }) %>
