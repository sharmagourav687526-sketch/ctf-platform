<%- include('../partials/header') %>
<%- include('../partials/admin_nav') %>
<div class="row-between">
  <h1>Submissions</h1>
  <div class="filters">
    <a class="btn btn-small <%= filter === '' ? '' : 'btn-ghost' %>" href="/admin/submissions">All</a>
    <a class="btn btn-small <%= filter === 'correct' ? '' : 'btn-ghost' %>" href="/admin/submissions?filter=correct">Correct</a>
    <a class="btn btn-small <%= filter === 'incorrect' ? '' : 'btn-ghost' %>" href="/admin/submissions?filter=incorrect">Wrong</a>
  </div>
</div>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>When</th><th>User</th><% if (settings.mode === 'teams') { %><th>Team</th><% } %><th>Challenge</th><th>Provided</th><th>Result</th><th>IP</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(function (s) { %>
        <tr>
          <td><%= fmtDate(s.created_at) %></td>
          <td><%= s.username %></td>
          <% if (settings.mode === 'teams') { %><td><%= s.team_name || '' %></td><% } %>
          <td><%= s.challenge %></td>
          <td><code class="wrap"><%= s.provided %></code></td>
          <td><span class="tag <%= s.correct ? 'tag-ok' : 'tag-bad' %>"><%= s.correct ? 'correct' : 'wrong' %></span></td>
          <td><%= s.ip || '' %></td>
          <td>
            <form method="post" action="/admin/submissions/<%= s.id %>/delete" class="inline" data-confirm="Delete this submission<%= s.correct ? ' and the solve it created' : '' %>?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (!rows.length) { %><tr><td colspan="8" class="muted">No submissions.</td></tr><% } %>
    </tbody>
  </table>
</div>
<p class="pager">
  <% if (page > 1) { %><a href="/admin/submissions?page=<%= page - 1 %><%= filter ? '&filter=' + filter : '' %>">&larr; Newer</a><% } %>
  <span class="muted">Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a href="/admin/submissions?page=<%= page + 1 %><%= filter ? '&filter=' + filter : '' %>">Older &rarr;</a><% } %>
</p>
<%- include('../partials/footer') %>
